@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix melod: <https://lod.academy/melod/vocab/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix schema: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix dash: <http://datashapes.org/dash#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix mus: <http://data.doremus.org/ontology#> .
@prefix terms: <https://mermeid-data-model-efbf77.pages.gitlab.rlp.net/> .
@prefix dataset: <https://adwmainz.pages.gitlab.rlp.net/nfdi4culture/cdmd/datasets/> .

melod:Expression
  a               sh:NodeShape, rdfs:Class ;
  owl:imports     terms:melod-terms.ttl , dataset:places.ttl , dataset:instrumentations.ttl , dataset:events.ttl , dataset:performanceEvents.ttl , dataset:expressions.ttl , dataset:bibliography.ttl;
  sh:property   [ sh:name "Label"@en, "Label"@de ;
                  sh:description "Expression title, e.g. 'Version 1'"@en, "Titel der Expression, z.B. 'Version 1'"@de ;
                  sh:minCount 1 ;
                  sh:maxCount 1 ;
                  sh:group melod:General ;
                  sh:path rdfs:label
                ] ;
  sh:property   [ sh:description "Genre or classification"@en, "Genre oder Klassifikation"@de ;
                  sh:name "Classification"@en, "Klassifikation"@de ;
                  sh:minCount 0 ;
                  sh:group melod:Keywords ;
                  sh:path melod:hasClassification ;
                  sh:or (
                    [ sh:class melod:Classification; rdfs:label "MerMEId Classification Vocabulary"@en, "MerMEId Klassifikationsvokabular"@de ; sh:nodeKind sh:IRI ]
                    [ rdfs:label "Custom classification"@en, "Benutzerdefinierte Klassifikation"@de ; sh:datatype xsd:string ]
                  )
                ] ;
  sh:property   [ sh:description "Link to an external web resource"@en, "Link zu einer externen Ressource"@de ;
                  sh:name "Link"@en, "Link"@de ;
                  sh:minCount 0 ;
                  sh:path owl:sameAs ;
                  sh:group melod:General ;
                  sh:pattern "^http(s)?://.+?/..+?" ;
                  sh:nodeKind sh:IRI
                ] ;
  sh:property   [ sh:description "Index identifiers"@en, "Index Identifikatoren"@de ;
                  sh:name "Index identifiers"@en, "Index Identifikatoren"@de ;
                  sh:minCount 0 ;
                  sh:group melod:General ;
                  sh:path melod:hasIdentifier ;
                  sh:node melod:Identifier
                ] ;
  sh:property   [ sh:description "The language usage is used to describe the languages, sublanguages, dialects, etc. represented within an expression. It can contain one or more languages."@en, "Die Sprache dient dazu, die innerhalb einer Expression vertretenen Sprachen, Dialekte usw. zu beschreiben. Sie kann eine oder mehrere Sprachen enthalten."@de ;
                  sh:name "Language"@en, "Sprache"@de ;
                  sh:group melod:General ;
                  sh:class melod:Language ;
                  sh:minCount 0 ;
                  sh:path melod:inLanguage
                ] ;
  sh:property   [ sh:description "Completeness of the expression (complete, incomplete oder unspecified)"@en, "Vollendung der Expression (vollständig, unvollständig oder nicht angegeben)"@de ;
                  sh:name "Completion Status"@en, "Status der Vollendung"@de ;
                  sh:group melod:General ;
                  sh:minCount 0 ;
                  sh:maxCount 1 ;
                  sh:path melod:completionStatus ;
                  sh:class melod:CompletionStatus
                ] ;
  sh:property   [ sh:description "Persons with connection to this particular version only, e.g. an arranger, or a text author in a collection of songs with different authors"@en, "Personen mit Bezug zu dieser bestimmten Version, z.B. ein Arrangeur oder ein Textautor in einer Sammlung von Liedern mit verschiedenen Autoren."@de ;
                  sh:name "Contribution"@en, "Mitwirkung"@de ;
                  sh:group melod:Creation ;
                  sh:minCount 0 ;
                  sh:node melod:Contribution ;
                  sh:path melod:hasContribution
                ] ;
  sh:property   [ sh:description "Date of the creation of the expression"@en, "Datum der Entstehung der Expression"@de ;
                  sh:name "Creation date"@en, "Entstehungsdatum"@de ;
                  sh:minCount 0 ;
                  sh:maxCount 1 ;
                  sh:group melod:Creation ;
                  sh:path schema:dateCreated ;
                  sh:or (
                    [ sh:node melod:ExactDate ; rdfs:label "Single date"@en, "Exaktes Datum"@de ]
                    [ sh:node melod:Date ; rdfs:label "Date span"@en, "Datumsspanne"@de ]
                  )
                ] ;
  sh:property   [ sh:description "Choose the creation place..."@en, "Wähle den Entstehungsort..."@de ;
                  sh:name "Creation place"@en, "Entstehungsort"@de ;
                  sh:minCount 0 ;
                  sh:maxCount 1 ;
                  sh:group melod:Creation ;
                  sh:path schema:locationCreated ; 
                  sh:nodeKind sh:IRI ;
                  #sh:defaultValue "https://mei-metadata.org/places/" ;
                  #sh:pattern      "^https://mei-metadata.org/places/\\d{8}" ;
                  sh:class melod:PlaceEntity ;
                ] ;
  sh:property   [ sh:description "Choose historic event..."@en, "Wähle historisches Ereignis..."@de ;
                  sh:name "History of creation"@en, "Historie der Entstehung"@de ;
                  sh:minCount 0 ;
                  sh:group melod:Creation ;
                  sh:path melod:hasHistoricEvent ;
                  #sh:defaultValue "https://mei-metadata.org/events/" ;
                  #sh:pattern      "^https://mei-metadata.org/events/\\d{8}" ;
                  sh:or (
                    [ sh:class melod:EventEntity ; rdfs:label "Event entity"@en, "Ereignis-Entität"@de ; sh:nodeKind sh:IRI ]
                    [ sh:node melod:Event ; rdfs:label "Event without IRI"@en, "Ereignis ohne IRI"@de ]
                  )
                ] ;
  sh:property   [ sh:description "Choose performance event..."@en, "Wähle Aufführung..."@de ;
                  sh:name "First performance"@en, "Uraufführung"@de ;
                  sh:minCount 0 ;
                  sh:maxCount 1 ;
                  sh:group melod:Performances ;
                  sh:path schema:firstPerformance ;
                  sh:nodeKind sh:IRI ;
                  #sh:defaultValue "https://mei-metadata.org/performanceEvents/" ;
                  #sh:pattern      "^https://mei-metadata.org/performanceEvents/\\d{8}" ;
                  #sh:class melod:PerformanceEvent
                  sh:or (
                    [ sh:class melod:PerformanceEventEntity ; rdfs:label "Performance Event entity"@en, "Aufführungs-Entität"@de ; sh:nodeKind sh:IRI ]
                    [ sh:node melod:PerformanceEvent ; rdfs:label "Performance Event without IRI"@en, "Aufführung ohne IRI"@de ]
                  )
                ] ;
  sh:property   [ sh:description "Choose performance event..."@en, "Wähle Aufführung..."@de ;
                  sh:name "Performance"@en, "Aufführung"@de ;
                  sh:minCount 0 ;
                  sh:group melod:Performances ;
                  sh:path melod:hasPerformance ;
                  sh:nodeKind sh:IRI ;
                  #sh:defaultValue "https://mei-metadata.org/performanceEvents/" ;
                  #sh:pattern      "^https://mei-metadata.org/performanceEvents/\\d{8}" ;
                  #sh:class melod:PerformanceEvent
                  sh:or (
                    [ sh:class melod:PerformanceEventEntity ; rdfs:label "Performance Event entity"@en, "Aufführungs-Entität"@de ; sh:nodeKind sh:IRI ]
                    [ sh:node melod:PerformanceEvent ; rdfs:label "Performance Event without IRI"@en, "Aufführung ohne IRI"@de ]
                  )
                ] ;
  sh:property   [ sh:description "Extent of the written music e.g. 50 T."@en, "Umfang der geschriebenen Musik, z.B. 50 S."@de ;
                  sh:name "Extent"@en, "Umfang"@de ;
                  sh:group melod:Music ;
                  sh:minCount 0 ;
                  sh:maxCount 1;
                  sh:path schema:materialExtent
                ] ;
  sh:property   [ sh:description "Allegro"@en, "Allegro"@de ;
                  sh:name "Tempo"@en, "Tempo"@de ;
                  sh:group melod:Music ;
                  sh:minCount 0 ;
                  sh:maxCount 1;
                  sh:path melod:hasTempo
                ] ;
  sh:property   [ sh:description "d minor modulating"@en, "d-Moll modulierend"@de ;
                  sh:name "Key"@en, "Tonart"@de ;
                  sh:group melod:Music ;
                  sh:minCount 0 ;
                  sh:maxCount 1 ;
                  sh:node melod:Key ;
                  sh:path mus:U11_has_key
                ] ;
  sh:property   [ sh:description "3/4 or c"@en, "3/4 oder c"@de ;
                  sh:name "Meter"@en, "Taktart"@de ;
                  sh:group melod:Music ;
                  sh:minCount 0 ;
                  sh:maxCount 1 ;
                  sh:node melod:Meter ;
                  sh:path melod:hasMeter
                ] ;
  sh:property   [ sh:description "01:23:00 or 4'33 or approx. 10 minutes"@en, "01:23:00 oder 4'33 oder ca. 10 Minuten"@de ;
                  sh:name "Performance duration"@en, "Aufführungsdauer"@de ;
                  sh:group melod:Music ;
                  sh:minCount 0 ;
                  sh:maxCount 1;
                  sh:path melod:hasDuration
                ] ;
  sh:property   [ sh:description "Information about mensuration"@en, "Informationen zur Mensur"@de ;
                  sh:name "Mensuration"@en, "Mensur"@de ;
                  sh:group melod:Music ;
                  sh:minCount 0 ;
                  sh:maxCount 1;
                  sh:path melod:hasMensuration
                ] ;
  sh:property   [ sh:description  "Choose instrumentation..."@en, "Wähle Besetzung..."@de ;
                  sh:name         "Instrumentation"@en, "Besetzung"@de ;
                  sh:maxCount 1;
                  sh:group melod:Music ;
                  sh:class         melod:InstrumentationEntity ;
                  sh:nodeKind sh:IRI ;
                  #sh:defaultValue "https://mei-metadata.org/instrumentation/" ;
                  #sh:pattern      "^https://mei-metadata.org/instrumentation/\\d{8}" ;
                  sh:path         melod:hasInstrumentation
                ] ;
  sh:property   [ sh:description  "Incipit"@en, "Incipit"@de ;
                  sh:group melod:Music ;
                  sh:name         "Incipit"@en, "Incipit"@de ;
                  sh:maxCount 1;
                  sh:node         melod:MusicIncipit ;
                  sh:path         melod:hasIncipit
                ] ;
  sh:property   [ sh:description "Choose component"@en, "Wähle Komponente..."@de ;
                  sh:name "Movement/Section"@en, "Satz/Abschnitt"@de ;
                  sh:group melod:Music ;
                  sh:minCount 0 ;
                  sh:path schema:includedComposition;
                  sh:or (
                    [ rdfs:label "Expression entity"@en, "Expression-Entity"@de ;
                      #sh:defaultValue "https://mei-metadata.org/expressions/" ;
                      #sh:pattern      "^https://mei-metadata.org/expressions/\\d{8}" ;
                      sh:class melod:ExpressionEntity ;
                      sh:nodeKind sh:IRI ]
                    [ sh:node melod:ExpressionComponent ; rdfs:label "Component (without IRI)"@en, "Komponente (ohne IRI)"@de ]
                  )
                ] ;
  sh:property   [ sh:description "Choose expression..."@en, "Wähle Expression..."@de ;
                  sh:name "has part"@en, "enthält"@de ;
                  sh:group melod:Relation ;
                  sh:minCount 0 ;
                  #sh:defaultValue "https://mei-metadata.org/expressions/" ;
                  #sh:pattern      "^https://mei-metadata.org/expressions/\\d{8}" ;
                  sh:class melod:ExpressionEntity ;
                  sh:nodeKind sh:IRI ;
                  sh:path melod:hasExpressionPart
                ] ;
  sh:property   [ sh:description "Choose expression..."@en, "Wähle Expression..."@de ;
                  sh:name "is part of"@en, "ist Teil von"@de ;
                  sh:group melod:Relation ;
                  sh:minCount 0 ;
                  #sh:defaultValue "https://mei-metadata.org/expressions/" ;
                  #sh:pattern      "^https://mei-metadata.org/expressions/\\d{8}" ;
                  sh:class melod:ExpressionEntity ;
                  sh:nodeKind sh:IRI ;
                  sh:path melod:isExpressionPartOf
                ] ;
#  sh:property   [ sh:name "Relation" ;
#                  sh:group melod:Relation ;
#                  sh:minCount 0 ;
#                  sh:class melod:ExpressionEntity ;
#                  sh:nodeKind sh:IRI ;
#                  sh:or (
#                   [ sh:name "has abridgement" ; sh:description "has abridgement" ; sh:path  melod:hasAbridgement ; rdfs:label "has abridgement" ]
#                    [ sh:name "is abridgement of" ; sh:description "is abridgement of" ; sh:path melod:isAbridgementOf ; rdfs:label "is abridgement of" ]
#                    [ sh:name "has adaptation" ; sh:description "has adaptation" ; sh:path  melod:hasAdaptation ; rdfs:label "has adaptation" ]
#                    [ sh:name "is adaptation of" ; sh:description "is adaptation of" ; sh:path melod:isAdaptationOf ; rdfs:label "is adaptation of" ]
#                    [ sh:name "has alternate" ; sh:description "has alternate" ; sh:path  melod:hasAlternate ; rdfs:label "has alternate" ]
#                    [ sh:name "is alternate of" ; sh:description "is alternate of" ; sh:path melod:isAlternateOf ; rdfs:label "is alternate of" ]
#                    [ sh:name "has arrangement" ; sh:description "has arrangement" ; sh:path  melod:hasArrangement ; rdfs:label "has arrangement" ]
#                    [ sh:name "is arrangement of" ; sh:description "is arrangement of" ; sh:path melod:isArrangementOf ; rdfs:label "is arrangement of" ]
#                    [ sh:name "has complement" ; sh:description "has complement" ; sh:path  melod:hasComplement ; rdfs:label "has complement" ]
#                    [ sh:name "is complement of" ; sh:description "is complement of" ; sh:path melod:isComplementOf ; rdfs:label "is complement of" ]
#                    [ sh:name "has imitation" ; sh:description "has imitation" ; sh:path  melod:hasImitation ; rdfs:label "has imitation" ]
#                    [ sh:name "is imitation of" ; sh:description "is imitation of" ; sh:path melod:isImitationOf ; rdfs:label "is imitation of" ]
#                    [ sh:name "has reconfiguration" ; sh:description "has reconfiguration" ; sh:path  melod:hasReconfiguration ; rdfs:label "has reconfiguration" ]
#                    [ sh:name "is reconfiguration of" ; sh:description "is reconfiguration of" ; sh:path melod:isReconfigurationOf ; rdfs:label "is reconfiguration of" ]
#                    [ sh:name "has reproduction" ; sh:description "has reproduction" ; sh:path  melod:hasReproduction ; rdfs:label "has reproduction" ]
#                    [ sh:name "is reproduction of" ; sh:description "is reproduction of" ; sh:path melod:isReproductionOf ; rdfs:label "is reproduction of" ]
#                    [ sh:name "has revision" ; sh:description "has revision" ; sh:path  melod:hasRevision ; rdfs:label "has revision" ]
#                    [ sh:name "is revision of" ; sh:description "is revision of" ; sh:path melod:isRevisionOf ; rdfs:label "is revision of" ]
#                    [ sh:name "has successor" ; sh:description "has successor" ; sh:path  melod:hasSuccessor ; rdfs:label "has successor" ]
#                    [ sh:name "is successor of" ; sh:description "is successor of" ; sh:path melod:isSuccessorOf ; rdfs:label "is successor of" ]
#                    [ sh:name "has summerization" ; sh:description "has summerization" ; sh:path  melod:hasSummerization ; rdfs:label "has summerization" ]
#                    [ sh:name "is summerization of" ; sh:description "is summerization of" ; sh:path melod:isSummerizationOf ; rdfs:label "is summerization of" ]
#                    [ sh:name "has supplement" ; sh:description "has supplement" ; sh:path  melod:hasSupplement ; rdfs:label "has supplement" ]
#                    [ sh:name "is supplement of" ; sh:description "is supplement of" ; sh:path melod:isSupplementOf ; rdfs:label "is supplement of" ]
#                    [ sh:name "has transformation" ; sh:description "has transformation" ; sh:path  melod:hasTransformation ; rdfs:label "has transformation" ]
#                    [ sh:name "is transformation of" ; sh:description "is transformation of" ; sh:path melod:isTransformationOf ; rdfs:label "is transformation of" ]
#                    [ sh:name "has translation" ; sh:description "has translation" ; sh:path  melod:hasTranslation ; rdfs:label "has translation" ]
#                    [ sh:name "is translation of" ; sh:description "is translation of" ; sh:path melod:isTranslationOf ; rdfs:label "is translation of" ]
 #                 )
 #               ] ;
  sh:property   [ sh:description "Description, annotations or further information"@en, "Beschreibung, Anmerkungen oder weitere Informationen"@de ;
                  sh:name "Description"@en, "Beschreibung"@de ;
                  dash:singleLine false ;
                  sh:group melod:General ;
                  sh:path melod:hasAnnotation ;
                  sh:node melod:Annotation ;
                ] ;
  sh:property   [ sh:description "Choose bibliography..."@en, "Wähle Bibliographie..."@de ;
                  sh:name "Bibliography"@en, "Bibliographie"@de ;
                  sh:minCount 0 ;
                  sh:group melod:Evidence ;
                  #sh:defaultValue "https://mei-metadata.org/bibliography/" ;
                  #sh:pattern      "^https://mei-metadata.org/bibliography/\\d{8}" ;
                  sh:class melod:BibliographyEntity ;
                  sh:nodeKind sh:IRI ;
                  sh:path schema:citation
                ] ;
  sh:targetClass  melod:Expression .

melod:Relation
  a               sh:PropertyGroup ;
  rdfs:label      "Relations"@en, "Beziehungen"@de .

melod:General
  a               sh:PropertyGroup ;
  rdfs:label      "General Information"@en, "Allgemeine Informationen"@de .

melod:Performances
  a               sh:PropertyGroup ;
  rdfs:label      "Performances"@en, "Aufführungen"@de .

melod:Creation
  a               sh:PropertyGroup ;
  rdfs:label      "Creation"@en, "Entstehung"@de .

melod:Music
  a               sh:PropertyGroup ;
  rdfs:label      "Music"@en, "Musik"@de .

melod:Keywords
  a               sh:PropertyGroup ;
  rdfs:label      "Classification and Keywords"@en, "Klassifikation und Schlagwörter"@de .

melod:Evidence
  a               sh:PropertyGroup ;
  rdfs:label      "Evidence"@en, "Belege"@de .

melod:Identifier
  a               sh:NodeShape ;

  sh:property   [ sh:description "Name of a list, catalogue or other numbering system in which the expression is identified (e.g. 'Opus', 'CNW', 'BWV', 'Neue Mozart-Ausgabe' etc.)."@en, "Name einer Liste, eines Katalogs oder eines anderen Nummerierungssystems, in dem die Expression identifiziert wird (z.B. 'Opus', 'CNW', 'BWV', 'Neue Mozart-Ausgabe' etc.)."@de ;
                  sh:name      "List name"@en, "Listenname"@de ;
                  sh:minCount  1 ;
                  sh:maxCount  1 ;
                  sh:path      rdfs:label
                ] ;
  sh:property   [ sh:description "The expressions's number or signature in the list identifying it."@en, "Die Nummer oder Signatur der Expression in der Liste, in der sie identifiziert wird."@de ;
                  sh:name      "Number"@en, "Nummer"@de ;
                  sh:minCount  1 ;
                  sh:maxCount  1 ;
                  sh:datatype  xsd:string ;
                  sh:path      owl:hasValue
                ] ;
  sh:targetClass  melod:Identifier .

melod:Annotation
  a               sh:NodeShape ;

  sh:property   [ sh:description "e.g. Comments, Edits, Notes" ;
                  sh:name      "Label" ;
                  sh:minCount  0 ;
                  sh:maxCount  1 ;
                  sh:path      rdfs:label
                ] ;
  sh:property   [ sh:description "Text" ;
                  sh:name      "Text" ;
                  sh:minCount  1 ;
                  sh:datatype  rdf:HTML ;
                  dash:singleLine false ;
                  sh:path      melod:paragraph
                ] ;
  sh:targetClass  melod:Annotation .

melod:Date
  a               sh:NodeShape ;
  owl:imports     terms:melod-terms.ttl ;
  rdfs:label     "Date span"@en, "Datumsspanne"@de ;
  sh:xone (
		[
			sh:property [
        sh:name      "Start date"@en, "Startdatum"@de ;
				sh:path schema:startDate ;
        rdfs:label "Start date"@en, "Startdatum"@de ;
        sh:datatype  xsd:date ;
				sh:maxCount  1 ;
			] ;
      sh:property [
        sh:name      "End date"@en, "Enddatum"@de ;
				sh:path schema:endDate ;
        rdfs:label "End date"@en, "Enddatum"@de ;
        sh:datatype  xsd:date ;
				sh:maxCount  1 ;
			];
		]
	  [
			sh:property [
        sh:name      "Not Before"@en, "Nicht vor"@de ;
				sh:path melod:notBefore ;
        rdfs:label "Not Before"@en, "Nicht vor"@de ;
				sh:maxCount  1 ;
			];
			sh:property [
        sh:name      "Not After"@en, "Nicht nach"@de ;
				sh:path melod:notAfter ;
        rdfs:label "Not After"@en, "Nicht nach"@de ;
				sh:maxCount  1 ;
			];
		]
	) ;
  sh:property   [ sh:description "e.g. 1800-1850"@en, "z.B. 1800-1850"@de ;
                  sh:name      "Description"@en, "Beschreibung"@de ;
                  sh:maxCount  1 ;
                  sh:path      schema:description
                ] ;
  sh:property   [ sh:description  "Certainty of the date"@en, "Sicherheit des Datums"@de ;
                  sh:name         "Certainty"@en, "Sicherheit"@de ;
                  sh:maxCount  1 ;
                  sh:path         melod:hasCertainty ;
                  sh:class melod:Certainty
                ] ;
  sh:targetClass  melod:Date .

  melod:ExactDate
  a               sh:NodeShape ;
  owl:imports     terms:melod-terms.ttl ;
  rdfs:label     "Single date"@en, "Exaktes Datum"@de ;
  sh:property   [ sh:name      "Date"@en, "Datum"@de ;
                  sh:maxCount  1 ;
                  sh:datatype  xsd:date ;
                  sh:path  melod:isodate
                ] ;
  sh:property   [ sh:description  "Certainty of the date"@en, "Sicherheit des Datums"@de ;
                  sh:name         "Certainty"@en, "Sicherheit"@de ;
                  sh:maxCount  1 ;
                  sh:path         melod:hasCertainty ;
                  sh:class melod:Certainty
                ] ;
  sh:property   [ sh:description "Description, annotations or further information"@en, "Beschreibung, Anmerkungen oder weitere Informationen"@de ;
                  sh:name      "Description"@en, "Beschreibung"@de ;
                  sh:maxCount  1 ;
                  sh:path      schema:description
                ] ;
  sh:targetClass  melod:ExactDate .

melod:Contribution
  a               sh:NodeShape ;
  rdfs:label      "Contributors"@en, "Mitwirkende"@de ;
  rdfs:comment "Persons with connection to this particular version only, e.g. an arranger, or a text author in a collection of songs with different authors"@en, "Personen mit Bezug zu dieser bestimmten Version, z.B. ein Arrangeur oder ein Textautor in einer Sammlung von Liedern mit verschiedenen Autoren."@de ;
  owl:imports     terms:melod-terms.ttl ;
  sh:property   [ sh:description  "Choose Person or Institution..."@en, "Wähle Person oder Institution..."@de ;
                  sh:name         "Person/Institution"@en, "Person/Institution"@de ;
                  sh:maxCount  1 ;
                  sh:minCount  1 ;
                  sh:path      melod:hasAgent ;
                  sh:nodeKind sh:IRI ;
                  sh:or (
                    [ sh:class melod:PersonEntity ; rdfs:label "Person"@en, "Person"@de ; owl:imports dataset:persons.ttl ]
                    [ sh:class melod:InstitutionEntity ; rdfs:label "Institution"@en, "Institution"@de ; owl:imports dataset:institutions.ttl ]
                  )
                ] ;
  sh:property   [ sh:description  "Role of the contribution"@en, "Rolle des Beitrags"@de ;
                  sh:name         "Role"@en, "Rolle"@de ;
                  sh:maxCount  1 ;
                  sh:path         melod:hasRole ;
                  sh:class melod:Role
                ] ;
  sh:property   [ sh:description  "Certainty of the contribution"@en, "Sicherheit des Beitrags"@de ;
                  sh:name         "Certainty"@en, "Sicherheit"@de ;
                  sh:maxCount  1 ;
                  sh:path         melod:hasCertainty ;
                  sh:class melod:Certainty
                ] ;
  sh:targetClass  melod:Contribution .

melod:ExpressionComponent
  a               sh:NodeShape, rdfs:Class ;
  rdfs:label      "Component (without IRI)"@en, "Komponente (ohne IRI)"@de ;
  sh:property   [ sh:name "No."@en, "Nr."@de ;
                  sh:description "Number of the expression component, e.g. movement number"@en, "Nummer der Expression-Komponente, z.B. Satznummer"@de ;
                  sh:minCount 0 ;
                  sh:maxCount 1 ;
                  sh:path schema:position
                ] ;
  sh:property   [ sh:name "Label"@en, "Bezeichnung"@de ;
                  sh:description "Title of expression component, e.g. 'Allegro'"@en, "Titel der Expression-Komponente, z.B. 'Allegro'"@de ;
                  sh:minCount 0 ;
                  sh:maxCount 1 ;
                  sh:path rdfs:label
                ] ;
  sh:property   [ sh:description "Allegro"@en, "Allegro"@de ;
                  sh:name "Tempo"@en, "Tempo"@de ;
                  sh:minCount 0 ;
                  sh:maxCount 1;
                  sh:path melod:hasTempo
                ] ;
  sh:property   [ sh:description "d minor modulierend"@en, "d-Moll modulierend"@de ;
                  sh:name "Key"@en, "Tonart"@de ;
                  sh:minCount 0 ;
                  sh:maxCount 1 ;
                  sh:node melod:Key ;
                  sh:path mus:U11_has_key
                ] ;
  sh:property   [ sh:description "3/4 or c"@en, "3/4 oder c"@de ;
                  sh:name "Meter"@en, "Taktart"@de ;
                  sh:minCount 0 ;
                  sh:maxCount 1 ;
                  sh:node melod:Meter ;
                  sh:path melod:hasMeter
                ] ;
  sh:property   [ sh:description  "Incipit"@en, "Incipit"@de ;
                  sh:name         "Incipit"@en, "Incipit"@de ;
                  sh:maxCount 1;
                  sh:node         melod:MusicIncipit ;
                  sh:path         melod:hasIncipit
                ] ;
  sh:property   [ sh:description  "Choose the instrumentation..."@en, "Wähle Besetzung..."@de ;
                  sh:name         "Instrumentation"@en, "Besetzung"@de ;
                  sh:maxCount 1;
                  sh:class         melod:InstrumentationEntity ;
                  sh:nodeKind sh:IRI ;
                  sh:path         melod:hasInstrumentation
                ] ;
  sh:targetClass  melod:ExpressionComponent .

melod:Key
  a               sh:NodeShape ;
  owl:imports     terms:melod-terms.ttl ;
  sh:property   [ sh:description "Pitch"@en, "Tonhöhe"@de ;
                  sh:name      "Pitch"@en, "Tonhöhe"@de ;
                  sh:minCount  1 ;
                  sh:maxCount  1 ;
                  sh:path      melod:hasPitch ;
                  sh:class melod:Pitch ;
                ] ;
  sh:property   [ sh:description "Accidental of the pitch"@en, "Vorzeichen der Note"@de ;
                  sh:name      "Accidental"@en, "Vorzeichen"@de ;
                  sh:minCount  0 ;
                  sh:maxCount  1 ;
                  sh:path      melod:hasAccidental ;
                  sh:class melod:Accidental ;
                ] ;
  sh:property   [ sh:name      "Mode"@en, "Tonart"@de ;
                  sh:minCount  1 ;
                  sh:maxCount  1 ;
                  sh:path      melod:isInMode ;
                  sh:class melod:Mode ;
                ] ;
  sh:property   [ sh:name      "Description"@en, "Beschreibung"@de ;
                  sh:description "Description, annotations or further information"@en, "Beschreibung, Anmerkungen oder weitere Informationen"@de ;
                  sh:minCount  0 ;
                  sh:maxCount  1 ;
                  sh:path      schema:description
                ] ;
  sh:targetClass  melod:Key .

melod:Meter
  a               sh:NodeShape ;
  sh:property   [ sh:name      "Count"@en, "Zählzeit"@de ;
                  sh:minCount  0 ;
                  sh:maxCount  1 ;
                  sh:path      melod:hasMeterCount ;
                  sh:datatype  xsd:integer
                ] ;
  sh:property   [ sh:name      "Unit"@en, "Zählmaß"@de ;
                  sh:minCount  0 ;
                  sh:maxCount  1 ;
                  sh:path      melod:inMeterUnit ;
                  sh:datatype  xsd:integer
                ]  ;
  sh:property   [ sh:name      "Symbol"@en, "Symbol"@de ;
                  sh:minCount  0 ;
                  sh:maxCount  1 ;
                  sh:path      melod:usesMeterSymbol ;
                  sh:in ( "common" "cut" ) ;
                ] ;
  sh:property   [ sh:name      "Description"@en, "Beschreibung"@de ;
                  sh:description "Description, annotations or further information"@en, "Beschreibung, Anmerkungen oder weitere Informationen"@de ;
                  sh:minCount  0 ;
                  sh:maxCount  1 ;
                  sh:path      schema:description
                ] ;
  sh:targetClass  melod:Meter .

melod:MusicIncipit
  a               sh:NodeShape ;
  rdfs:label      "Incipit"@en, "Incipit"@de ;
  sh:property   [ sh:description  "Data of the plaine and easy code of the incipit"@en, "Daten des plaine and easy code des Incipits"@de ;
                  sh:name         "PAE data"@en, "PAE-Daten"@de ;
                  sh:path         melod:hasIncipitValue ;
                ] ;
  sh:property   [ sh:description  "Text of the Incipit"@en, "Text des Incipits"@de ;
                  sh:name         "Incipit Text"@en, "Incipit-Text"@de ;
                  sh:path         melod:hasIncipitText ;
                  dash:singleLine false ;
                  sh:minCount     0 ;
                  sh:maxCount     1
                ] ;
  sh:property   [ sh:description  "Incipit in MEI"@en, "Incipit in MEI"@de ;
                  sh:name         "Incipit in MEI"@en, "Incipit in MEI"@de ;
                  sh:path         melod:hasMEIScore ;
                  dash:singleLine false ;
                  sh:datatype     xsd:base64Binary ;
                  sh:minCount     0 ;
                ] ;        
  sh:targetClass  melod:MusicIncipit .


melod:Event
  a sh:NodeShape, rdfs:Class ;
  owl:imports     dataset:places.ttl ;
  rdfs:label      "Event (without IRI)"@en, "Ereignis (ohne IRI)"@de ;
  sh:property   [ sh:description "Name of the Event"@en, "Name des Ereignisses"@de ;
                  sh:name "Name"@en, "Name"@de ;
                  sh:minCount 1 ;
                  sh:maxCount 1;
                  sh:path rdfs:label
                ] ;
  sh:property   [ sh:description "Choose place..."@en, "Wähle Ort..."@de ;
                  sh:name "Place"@en, "Ort"@de ;
                  sh:maxCount 1;
                  sh:nodeKind sh:IRI ;
                  sh:class melod:PlaceEntity ;
                  #sh:defaultValue "https://mei-metadata.org/places/" ;
                  #sh:pattern      "^https://mei-metadata.org/places/\\d{8}" ;
                  sh:path schema:location
                ] ;
  sh:property   [ sh:description "Date of the event"@en, "Datum des Ereignisses"@de ;
                  sh:name "Date"@en, "Datum"@de ;
                  sh:minCount 0 ;
                  sh:maxCount 1 ;
                  sh:path melod:hasEventDate ;
                  sh:or (
                    [ sh:node melod:ExactDate ; rdfs:label "Single date" ]
                    [ sh:node melod:Date ; rdfs:label "Date span" ]
                  )
                ] ;
  sh:property   [ sh:description "Description, annotations or further information"@en, "Beschreibung, Anmerkungen oder weitere Informationen"@de ;
                  sh:name "Description"@en, "Beschreibung"@de ;
                  dash:singleLine false ;
                  sh:path melod:hasAnnotation ;
                  sh:node melod:Annotation ;
                ] ;
  sh:targetClass melod:Event .

  melod:PerformanceEvent
  a sh:NodeShape, rdfs:Class ;
  owl:imports     dataset:places.ttl ;
  rdfs:label "Performance Event (without IRI)"@en, "Aufführung (ohne IRI)"@de ;
  sh:property   [ sh:description "Name of the Performance Event"@en, "Name der Aufführung"@de ;
                  sh:name "Name"@en, "Name"@de ;
                  sh:minCount 1 ;
                  sh:maxCount 1;
                  sh:path rdfs:label
                ] ;
  sh:property   [ sh:description "Choose place..."@en, "Wähle Ort..."@de ;
                  sh:name "Place"@en, "Ort"@de ;
                  sh:maxCount 1;
                  sh:nodeKind sh:IRI ;
                  sh:class melod:PlaceEntity ;
                  #sh:defaultValue "https://mei-metadata.org/places/" ;
                  #sh:pattern      "^https://mei-metadata.org/places/\\d{8}" ;
                  sh:path schema:location
                ] ;
  sh:property   [ sh:description "Date of the Performance Event"@en, "Datum der Aufführung"@de ;
                  sh:name "Date"@en, "Datum"@de ;
                  sh:minCount 0 ;
                  sh:maxCount 1 ;
                  sh:path melod:hasEventDate ;
                  sh:or (
                    [ sh:node melod:ExactDate ; rdfs:label "Single date" ]
                    [ sh:node melod:Date ; rdfs:label "Date span" ]
                  )
                ] ;
  sh:property   [ sh:description "Description, annotations or further information"@en, "Beschreibung, Anmerkungen oder weitere Informationen"@de ;
                  sh:name "Description"@en, "Beschreibung"@de ;
                  dash:singleLine false ;
                  sh:path melod:hasAnnotation ;
                  sh:node melod:Annotation ;
                ] ;
  sh:targetClass melod:PerformanceEvent .