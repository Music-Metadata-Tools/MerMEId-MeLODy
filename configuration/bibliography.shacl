@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix melod: <https://lod.academy/melod/vocab/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix schema: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dash: <http://datashapes.org/dash#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix terms: <https://mermeid-data-model-efbf77.pages.gitlab.rlp.net/> .

melod:Bibliography
  sh:targetClass melod:Bibliography ;
  a sh:NodeShape, rdfs:Class ;
  owl:imports     terms:melod-terms.ttl;
  sh:property   [ sh:description "Genre of the bibliographic entry"@en , "Genre des bibliographischen Eintrags"@de ;
                  sh:name "Genre"@en , "Genre"@de ;
                  sh:minCount 0 ;
                  sh:maxCount 1 ;
                  sh:group melod:Reference ;
                  sh:path schema:genre ;
                  sh:class melod:BibliographicGenre ;
                ] ;
  sh:property   [ sh:minCount 1 ;
                  sh:maxCount 1 ;
                  sh:path melod:hasAbbreviation ;
                  sh:group melod:Titles ;
                  sh:name "Abbreviation"@en , "Abkürzung"@de ;
                  sh:description "Abbreviation or short title of the bibliographic entry"@en , "Abkürzung oder Kurztitel des bibliographischen Eintrags"@de
                ] ;
  sh:property   [ sh:minCount     0 ;
                  sh:name "Link to an external resource"@en , "Link zu einer externen Ressource"@de ;
                  sh:description "External resource, e.g. Zotero"@en , "Externe Ressource, z.B. Zotero"@de ;
                  sh:path         owl:sameAs ;
                  sh:nodeKind sh:IRI ;
                  sh:pattern "^http(s)?://.+?/..+?" ;
                  sh:group melod:Titles ;
                ] ;
  sh:property   [ sh:minCount 0 ;
                  sh:path melod:hasTitle ;
                  sh:node melod:Title ;
                  sh:group melod:Titles ;
                  sh:name "Titles of Monograph/Article"@en , "Titel der Monographie/des Artikels"@de ;
                ] ;
  sh:property   [ sh:name "Person/Institution"@en , "Person/Institution"@de ;
                  sh:description "Choose person or institution..."@en , "Wähle Person oder Institution..."@de ;
                  sh:minCount 0 ;
                  sh:path schema:author ;
                  sh:group melod:Authors ;
                  sh:nodeKind sh:IRI ;
                  sh:or (
                    [ sh:class melod:PersonEntity ; rdfs:label "Person" ]
                    [ sh:class melod:InstitutionEntity ; rdfs:label "Institution" ]
                  )
                ] ;
  sh:property   [ sh:name "Person/Institution"@en , "Person/Institution"@de ;
                  sh:description "Choose person or institution..."@en , "Wähle Person oder Institution..."@de ;
                  sh:minCount 0 ;
                  sh:path melod:hasEditor ;
                  sh:group melod:Editors ;
                  sh:nodeKind sh:IRI ;
                  sh:or (
                    [ sh:class melod:PersonEntity ; rdfs:label "Person" ]
                    [ sh:class melod:InstitutionEntity ; rdfs:label "Institution" ]
                  )
                ] ;
  sh:property   [ sh:name "Imprint"@en , "Druck"@de ;
                  sh:description "Imprint of the bibliographic entry"@en , "Druckangabe des bibliographischen Eintrags"@de ;
                  sh:minCount 1 ;
                  sh:maxCount 1 ;
                  sh:group melod:Publication ;
                  sh:path schema:publication ;
                  sh:node melod:PublicationEvent
                ] ;
  sh:property   [ sh:name "Language"@en , "Sprache"@de ;
                  sh:minCount 0 ;
                  sh:maxCount 1 ;
                  sh:group melod:Publication ;
                  sh:path schema:inLanguage ;
                  sh:class melod:Language
                ] ;
  sh:property   [ sh:name "Pages"@en , "Seiten"@de ;
                  sh:description "Scope of the article, chapter, ..."@en , "Umfang des Artikels, Kapitels, ..."@de ;
                  sh:minCount 0 ;
                  sh:maxCount 1 ;
                  sh:group melod:Volume ;
                  sh:path schema:pagination
                ] ;
  sh:property   [ sh:name "Extent"@en , "Umfang"@de ;
                  sh:minCount 0 ;
                  sh:maxCount 1 ;
                  sh:group melod:Volume ;
                  sh:description "Extent of the bibliographic entry"@en , "Umfang des bibliographischen Eintrags"@de ;
                  sh:minCount 0 ;
                  sh:path schema:materialExtent
                ] ;
  sh:property   [ sh:description "Name of the journal or series"@en , "Name der Zeitschrift oder Reihe"@de ;
                  sh:name "Journal or Series"@en , "Zeitschrift oder Reihe"@de ;
                  sh:minCount 0 ;
                  sh:maxCount 1 ;
                  sh:group melod:Titles ;
                  sh:path schema:isPartOf ;
                  sh:class melod:BibliographyEntity ;
                ] ;
  sh:property   [ sh:description "Position in the series, volume number"@en , "Position in der Reihe, Bandnummer"@de ;
                  sh:name "Volume number"@en , "Bandnummer"@de ;
                  sh:minCount 0 ;
                  sh:maxCount 1 ;
                  sh:group melod:Volume ;
                  sh:path schema:position
                ] ;
  sh:property   [ sh:minCount 0 ;
                  sh:maxCount 1 ;
                  sh:path melod:hasClassification;
                  sh:group melod:Notes ;
                  sh:name "Classification"@en , "Klassifikation"@de ;
                  sh:description "Classification of the bibliographic entry"@en , "Klassifikation des bibliographischen Eintrags"@de ;
                ] ;
  sh:property   [ sh:description "Description, annotations or further information"@en , "Beschreibung, Anmerkungen oder weitere Informationen"@de ;
                  sh:name "Description"@en , "Beschreibung"@de ;
                  dash:singleLine false ;
                  sh:group melod:Notes ;
                  sh:path schema:description
                ] .

melod:PublicationEvent
  a               sh:NodeShape ;
  sh:property   [ sh:description "Label of the publication event"@en , "Label der Publikation"@de ;
                  sh:name      "Label"@en , "Label"@de ;
                  sh:minCount  0 ;
                  sh:maxCount  1 ;
                  sh:path      rdfs:label
                ] ;
  sh:property   [ sh:name      "Start date"@en , "Startdatum"@de ;
                  sh:maxCount  1 ;
                  sh:path      schema:startDate ;
                  sh:datatype  xsd:date
                ] ;
  sh:property   [ sh:name      "End date"@en , "Enddatum"@de ;
                  sh:maxCount  1 ;
                  sh:path      schema:endDate ;
                  sh:datatype  xsd:date
                ] ;
  sh:property   [ sh:maxCount     1 ;
                  sh:minCount     0 ;
                  sh:name         "Publisher"@en , "Herausgeber:in"@de ;
                  sh:path         schema:publishedBy ;
                  #sh:defaultValue "https://mei-metadata.org/persons/" ;
                  #sh:pattern      "^https://mei-metadata.org/persons/\\d{8}" ;
                  sh:class melod:PersonEntity ;
                ] ;
  sh:property   [ sh:maxCount     1 ;
                  sh:minCount     0 ;
                  sh:name         "Place"@en , "Ort"@de ;
                  sh:path         schema:location ;
                  #sh:defaultValue "https://mei-metadata.org/places/" ;
                  #sh:pattern      "^https://mei-metadata.org/places/\\d{8}" ;
                  sh:class melod:PlaceEntity ;
                ] ;
  sh:property   [ sh:description "Description of the publication event"@en , "Beschreibung der Publikation"@de ;
                  sh:name      "Description"@en , "Beschreibung"@de ;
                  sh:minCount  0 ;
                  sh:maxCount  1 ;
                  sh:path      schema:description
                ] ;
  sh:targetClass  schema:PublicationEvent .

  melod:Title
  a               sh:NodeShape ;
  owl:imports     terms:melod-terms.ttl ;
  sh:property   [ sh:description "Title of the bibliographic entry"@en , "Titel des bibliographischen Eintrags"@de ;
                  sh:name      "Title"@en , "Titel"@de ;
                  sh:minCount  0 ;
                  sh:maxCount  1 ;
                  sh:path      rdfs:label
                ] ;
  sh:property   [ sh:name      "Level of the title"@en , "Level des Titels"@de ;
                  sh:description "Level, e.g. analytic"@en , "Level, z.B. analytisch"@de ;
                  sh:minCount  0 ;
                  sh:maxCount  1 ;
                  sh:path      melod:hasTitleLevel ;
                  sh:class melod:BibliographicLevel
                ] ;
  #sh:property   [ sh:name      "Type" ;
   #               sh:description "Type, e.g. subtitle" ;
   #               sh:minCount  0 ;
   #               sh:maxCount  1 ;
   #               sh:path      melod:hasTitleType ;
   #               sh:or (
   #                 [ sh:class melod:TitleType ; rdfs:label "Select from list" ; sh:nodeKind sh:IRI ]
   #                 [ rdfs:label "Custom type" ; sh:datatype xsd:string ]
   #               )
                  
    #            ] ;
  sh:targetClass  melod:Title .

  melod:Reference
  a               sh:PropertyGroup ;
  rdfs:label      "Reference Type"@en , "Referenztyp"@de .

  melod:Authors
  a               sh:PropertyGroup ;
  rdfs:label      "Authors"@en , "Autor:innen"@de .

  melod:Editors
  a               sh:PropertyGroup ;
  rdfs:label      "Editors"@en , "Herausgeber:innen"@de .

  melod:Titles
  a               sh:PropertyGroup ;
  rdfs:label      "Titles"@en , "Titel"@de .

  melod:Volume
  a               sh:PropertyGroup ;
  rdfs:label      "Volume"@en , "Band"@de .

  melod:Publication
  a               sh:PropertyGroup ;
  rdfs:label      "Publication"@en , "Publikation"@de .

  melod:Notes
  a               sh:PropertyGroup ;
  rdfs:label      "Notes"@en , "Anmerkungen"@de .