@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix melod: <https://lod.academy/melod/vocab/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix schema: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dash: <http://datashapes.org/dash#> .
@prefix dataset: <https://adwmainz.pages.gitlab.rlp.net/nfdi4culture/cdmd/datasets/> .

melod:Venue
  a sh:NodeShape, rdfs:Class ;
  owl:imports     dataset:places.ttl ;
  sh:property   [ sh:description "Name of the venue"@en, "Name des Veranstaltungsortes"@de ;
                  sh:name "Name"@en, "Name"@de ;
                  sh:minCount 1 ;
                  sh:maxCount 1;
                  sh:path schema:name
                ] ;
  sh:property   [ sh:description "Choose place..."@en, "Wähle Ort..."@de ;
                  sh:name "Place"@en, "Ort"@de ;
                  sh:maxCount 1;
                  sh:class melod:PlaceEntity ;
                  #sh:defaultValue "https://mei-metadata.org/places/" ;
                  #sh:pattern      "^https://mei-metadata.org/places/\\d{8}" ;
                  sh:path schema:containedInPlace
                ] ;
  sh:property   [ sh:description "External resource (e.g. geonames)"@en, "Externe Ressource (z.B. geonames)"@de ;
                  sh:name "Link"@en, "Link"@de ;
                  sh:nodeKind sh:IRI ;
                  sh:path owl:sameAs ;
                  sh:pattern "^http(s)?://.+?/..+?" ;
                ] ;
  sh:property   [ sh:description "Description, annotations or further information"@en, "Beschreibung, Annotationen oder weitere Informationen"@de ;
                  sh:name "Description"@en, "Beschreibung"@de ;
                  sh:minCount 0 ;
                  sh:maxCount 1;
                  dash:singleLine false ;
                  sh:path schema:description
                ] ;
  sh:targetClass melod:Venue .
