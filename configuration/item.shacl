@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix melod: <https://lod.academy/melod/vocab/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix schema: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix dash: <http://datashapes.org/dash#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix cidoc: <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix lrmoo: <http://iflastandards.info/ns/lrm/lrmoo/> .
@prefix terms: <https://mermeid-data-model-efbf77.pages.gitlab.rlp.net/> .

melod:Item
  a               sh:NodeShape, rdfs:Class ;
  owl:imports     terms:melod-terms.ttl ;
  sh:property   [ sh:description "Label for the item"@en,"Label des Items"@de ;
                  sh:name "Label"@en,"Label"@de ;
                  sh:group melod:General ;
                  sh:minCount 1 ;
                  sh:maxCount 1;
                  sh:path rdfs:label
                ] ;
  sh:property   [ sh:description "External resource, e.g. RISM or other catalogue numbers"@en,"Externe Ressource, z.B. RISM oder andere Kataloge" ;
                  sh:name "Link"@en,"Link"@de ;
                  sh:minCount 0 ;
                  sh:group melod:General ;
                  sh:path owl:sameAs ;
                  sh:nodeKind sh:IRI
                ] ;
  sh:property   [ sh:name "Identifier"@en,"Identifier"@de ;
                  sh:minCount 0 ;
                  sh:group melod:General ;
                  sh:node melod:Identifier ;
                  sh:path melod:hasIdentifier
                ] ;
  sh:property   [ sh:description "Keywords for searching, grouping and indexing"@en,"Schlagwörter zum Suchen, Gruppieren und Indizieren"@de ;
                  sh:name "Classification"@en,"Klassifikation"@de ;
                  sh:minCount 0 ;
                  sh:group melod:Keywords ;
                  sh:path melod:hasClassification ;
                  sh:or (
                    [ sh:class melod:ClassificationOfManifestation; rdfs:label "MerMEId Classification Vocabulary" ; sh:nodeKind sh:IRI ]
                    [ rdfs:label "Custom classification" ; sh:datatype xsd:string ]
                  )
                ] ;
  sh:property   [ sh:description "Choose institution..."@en,"Wähle Institution..."@de ;
                  sh:name "Repository"@en,"Fundort"@de ;
                  sh:minCount 0 ;
                  sh:maxCount 1 ;
                  sh:group melod:Location ;
                  #sh:defaultValue "https://mei-metadata.org/institutions/" ;
                  #sh:pattern      "^https://mei-metadata.org/institutions/\\d{8}" ;
                  sh:class melod:InstitutionEntity ;
                  sh:path cidoc:P50_has_current_keeper
                ] ;
  sh:property   [ sh:description "Shelfmark or other signature identifying this item in the repository"@en, "Signatur, die dieses Exemplar an dem Fundort identifiziert"@de ;
                  sh:name "Shelfmark"@en,"Signatur"@de ;
                  sh:minCount 0 ;
                  sh:maxCount 1 ;
                  sh:group melod:Location ;
                  sh:path melod:hasShelfmark
                ] ;
  sh:property   [ sh:description "Former shelfmark or other signature identifying this item in the repository"@en,"Frühere Signatur, die dieses Exemplar identifiert hat"@de ;
                  sh:name "Former Shelfmark"@en,"Frühere Signatur"@de ;
                  sh:minCount 0 ;
                  sh:maxCount 1 ;
                  sh:group melod:Location ;
                  sh:path melod:hasFormerShelfmark
                ] ;
  sh:property   [ sh:description "Acquisition date"@en,"Erwerbsdatum"@de ;
                  sh:name "Acquisition date"@en,"Erwerbsdatum"@de ;
                  sh:minCount 0 ;
                  sh:maxCount 1 ;
                  sh:group melod:Provenance ;
                  sh:path melod:hasAcquisition ;
                  sh:or (
                    [ sh:node melod:ExactDate ; rdfs:label "Single date" ]
                    [ sh:node melod:Date ; rdfs:label "Date span" ]
                  )
                ] ;
  sh:property   [ sh:description "Choose provenance event..."@en,"Wähle Provenienzereignis..." ;
                  sh:name "Event"@en,"Ereignis"@de ;
                  sh:minCount 0 ;
                  sh:group melod:Provenance ;
                  #sh:defaultValue "https://mei-metadata.org/events/" ;
                  #sh:pattern      "^https://mei-metadata.org/events/\\d{8}" ;
                  sh:or (
                    [ sh:class melod:EventEntity ; rdfs:label "Event entity"@en,"Ereignis-Entität"@de ; sh:nodeKind sh:IRI ]
                    [ sh:node melod:Event ; rdfs:label "Event without IRI"@en,"Ereignis ohne IRI"@de ]
                  ) ;
                  sh:path melod:hasProvenance
                ] ;
  sh:property   [ sh:description "Title page of the item"@en,"Titelseite des Items"@de ;
                  sh:name "Title pages"@en,"Titelseiten"@de ;
                  sh:minCount 0 ;
                  sh:group melod:PhysicalDescription ;
                  sh:path melod:hasTitlePage ;
                  sh:node melod:TitlePage
                ] ;
  sh:property   [ sh:name      "Hand"@en,"Hand"@de ;
                  sh:minCount  0 ;
                  sh:group melod:PhysicalDescription ;
                  sh:path      melod:hasHand ;
                  sh:node melod:Hand
                ] ;
  sh:property   [ sh:description "Choose event related to the history and creation of the item..."@en,"Wähle Ereignis, dass die Geschichte und Entstehung des Items beschreibt..." ;
                  sh:name "History"@en,"Historie"@de ;
                  sh:group melod:General ;
                  sh:minCount 0 ;
                  #sh:defaultValue "https://mei-metadata.org/events/" ;
                  #sh:pattern      "^https://mei-metadata.org/events/\\d{8}" ;
                  sh:or (
                    [ sh:class melod:EventEntity ; rdfs:label "Event Entity"@en,"Ereignis-Entität"@de ; sh:nodeKind sh:IRI ]
                    [ sh:node melod:Event ; rdfs:label "Event"@en,"Ereignis" ]
                  ) ;
                  sh:path melod:hasHistoricEvent
                ] ;
  sh:property   [ sh:description "Physical Description"@en,"Physische Beschreibung"@de ;
                  sh:name "Physical Description"@en,"Physische Beschreibung"@de ;
                  sh:minCount 0 ;
                  sh:maxCount 1 ;
                  sh:group melod:PhysicalDescription ;
                  sh:path melod:hasPhysicalDescription ;
                  sh:node melod:PhysDesc
                ] ;
  sh:property   [ sh:description "Choose item..."@en,"Wähle item..."@de ;
                  sh:name "has part"@en,"Beinhaltet"@de ;
                  sh:group melod:Relation ;
                  sh:minCount 0 ;
                  #sh:defaultValue "https://mei-metadata.org/items/" ;
                  #sh:pattern      "^https://mei-metadata.org/items/\\d{8}" ;
                  sh:class melod:ItemEntity ;
                  sh:path melod:hasItemPart
                ] ;
  sh:property   [ sh:description "Choose item..."@en,"Wähle item..."@de ;
                  sh:name "is part of"@en,"Enthalten in"@de ;
                  sh:group melod:Relation ;
                  sh:minCount 0 ;
                  #sh:defaultValue "https://mei-metadata.org/items/" ;
                  #sh:pattern      "^https://mei-metadata.org/items/\\d{8}" ;
                  sh:class melod:ItemEntity ;
                  sh:path melod:isItemPartOf
                ] ;
  sh:property   [ sh:description "Choose manifestation..."@en,"Wähle Manifestation..."@de ;
                  sh:name "is materialization of"@en,"ist Materialisierung von"@de ;
                  sh:group melod:Relation ;
                  sh:minCount 0 ;
                  #sh:defaultValue "https://mei-metadata.org/manifestations/" ;
                  #sh:pattern      "^https://mei-metadata.org/manifestation/\\d{8}" ;
                  sh:class melod:ManifestationEntity ;
                  sh:path lrmoo:R7_exemplifies
                ] ;
#  sh:property   [ sh:name "Relation" ;
 #                 sh:group melod:Relation ;
 #                 sh:minCount 0 ;
 #                 sh:class melod:ItemEntity ;
 #                 sh:nodeKind sh:IRI ;
 #                 sh:or (
 #                   [ sh:name "has abridgement" ; sh:description "has abridgement" ; sh:path  melod:hasAbridgement ; rdfs:label "has abridgement" ]
 #                   [ sh:name "is abridgement of" ; sh:description "is abridgement of" ; sh:path melod:isAbridgementOf ; rdfs:label "is abridgement of" ]
 #                   [ sh:name "has adaptation" ; sh:description "has adaptation" ; sh:path  melod:hasAdaptation ; rdfs:label "has adaptation" ]
#                   [ sh:name "is adaptation of" ; sh:description "is adaptation of" ; sh:path melod:isAdaptationOf ; rdfs:label "is adaptation of" ]
#                   [ sh:name "has alternate" ; sh:description "has alternate" ; sh:path  melod:hasAlternate ; rdfs:label "has alternate" ]
#                    [ sh:name "is alternate of" ; sh:description "is alternate of" ; sh:path melod:isAlternateOf ; rdfs:label "is alternate of" ]
 #                   [ sh:name "has arrangement" ; sh:description "has arrangement" ; sh:path  melod:hasArrangement ; rdfs:label "has arrangement" ]
 #                   [ sh:name "is arrangement of" ; sh:description "is arrangement of" ; sh:path melod:isArrangementOf ; rdfs:label "is arrangement of" ]
#                    [ sh:name "has complement" ; sh:description "has complement" ; sh:path  melod:hasComplement ; rdfs:label "has complement" ]
#                    [ sh:name "is complement of" ; sh:description "is complement of" ; sh:path melod:isComplementOf ; rdfs:label "is complement of" ]
#                    [ sh:name "has imitation" ; sh:description "has imitation" ; sh:path  melod:hasImitation ; rdfs:label "has imitation" ]
#                    [ sh:name "is imitation of" ; sh:description "is imitation of" ; sh:path melod:isImitationOf ; rdfs:label "is imitation of" ]
#                    [ sh:name "has reconfiguration" ; sh:description "has reconfiguration" ; sh:path  melod:hasReconfiguration ; rdfs:label "has reconfiguration" ]
#                    [ sh:name "is reconfiguration of" ; sh:description "is reconfiguration of" ; sh:path melod:isReconfigurationOf ; rdfs:label "is reconfiguration of" ]
#                    [ sh:name "has reproduction" ; sh:description "has reproduction" ; sh:path  melod:hasReproduction ; rdfs:label "has reproduction" ]
#                    [ sh:name "is reproduction of" ; sh:description "is reproduction of" ; sh:path melod:isReproductionOf ; rdfs:label "is reproduction of" ]
#                    [ sh:name "has revision" ; sh:description "has revision" ; sh:path  melod:hasRevision ; rdfs:label "has revision" ]
#                    [ sh:name "is revision of" ; sh:description "is revision of" ; sh:path melod:isRevisionOf ; rdfs:label "is revision of" ]
#                    [ sh:name "has successor" ; sh:description "has successor" ; sh:path  melod:hasSuccessor ; rdfs:label "has successor" ]
#                    [ sh:name "is successor of" ; sh:description "is successor of" ; sh:path melod:isSuccessorOf ; rdfs:label "is successor of" ]
#                    [ sh:name "has summerization" ; sh:description "has summerization" ; sh:path  melod:hasSummerization ; rdfs:label "has summerization" ]
#                    [ sh:name "is summerization of" ; sh:description "is summerization of" ; sh:path melod:isSummerizationOf ; rdfs:label "is summerization of" ]
#                    [ sh:name "has supplement" ; sh:description "has supplement" ; sh:path  melod:hasSupplement ; rdfs:label "has supplement" ]
#                    [ sh:name "is supplement of" ; sh:description "is supplement of" ; sh:path melod:isSupplementOf ; rdfs:label "is supplement of" ]
#                    [ sh:name "has transformation" ; sh:description "has transformation" ; sh:path  melod:hasTransformation ; rdfs:label "has transformation" ]
#                    [ sh:name "is transformation of" ; sh:description "is transformation of" ; sh:path melod:isTransformationOf ; rdfs:label "is transformation of" ]
#                    [ sh:name "has translation" ; sh:description "has translation" ; sh:path  melod:hasTranslation ; rdfs:label "has translation" ]
#                    [ sh:name "is translation of" ; sh:description "is translation of" ; sh:path melod:isTranslationOf ; rdfs:label "is translation of" ]
#                  )
#                ] ;
  sh:property   [ sh:description "Description, annotations or further information"@en, "Beschreibung, Anmerkungen oder weitere Informationen"@de ;
                  sh:name      "Description"@en, "Beschreibung"@de ;
                  sh:group melod:General ;
                  sh:path melod:hasAnnotation ;
                  sh:node melod:Annotation
                ] ;
  sh:property   [ sh:description "Links" ;
                  sh:name "Links" ;
                  sh:group melod:General ;
                  sh:path melod:hasLinks ;
                  sh:node melod:Link
                ] ;
  sh:targetClass  melod:Item .

  melod:Date
  a               sh:NodeShape ;
  owl:imports     terms:melod-terms.ttl ;
  rdfs:label     "Date span"@en,"Datumsspanne"@de ;
  sh:xone (
		[
			sh:property [
        sh:name      "Start date"@en, "Startdatum"@de ;
				sh:path schema:startDate ;
        rdfs:label "Start date"@en, "Startdatum"@de ;
        sh:datatype  xsd:date ;
				sh:maxCount  1 ;
			] ;
      sh:property [
        sh:name      "End date"@en, "Enddatum"@de ;
				sh:path schema:endDate ;
        rdfs:label "End date"@en, "Enddatum"@de ;
        sh:datatype  xsd:date ;
				sh:maxCount  1 ;
			];
		]
	  [
			sh:property [
        sh:name      "Not Before"@en, "Nicht vor"@de ;
				sh:path melod:notBefore ;
        rdfs:label "Not Before"@en, "Nicht vor"@de ;
				sh:maxCount  1 ;
			];
			sh:property [
        sh:name      "Not After"@en, "Nicht nach"@de ;
				sh:path melod:notAfter ;
        rdfs:label "Not After"@en, "Nicht nach"@de ;
				sh:maxCount  1 ;
			];
		]
	) ;
  sh:property   [ sh:description "e.g. 1800-1850"@en, "z.B. 1800-1850"@de ;
                  sh:name      "Description"@en, "Beschreibung"@de ;
                  sh:maxCount  1 ;
                  sh:path      schema:description
                ] ;
  sh:property   [ sh:description  "Certainty of the date"@en, "Sicherheit des Datums"@de ;
                  sh:name         "Certainty"@en, "Sicherheit"@de ;
                  sh:maxCount  1 ;
                  sh:path         melod:hasCertainty ;
                  sh:class melod:Certainty
                ] ;
  sh:targetClass  melod:Date .

  melod:ExactDate
  a               sh:NodeShape ;
  owl:imports     terms:melod-terms.ttl ;
  rdfs:label     "Single date"@en, "Exaktes Datum"@de ;
  sh:property   [ sh:name      "Date" ;
                  sh:maxCount  1 ;
                  sh:datatype  xsd:date ;
                  sh:path  melod:isodate
                ] ;
  sh:property   [ sh:description  "Certainty of the date"@en, "Sicherheit des Datums"@de ;
                  sh:name         "Certainty"@en, "Sicherheit"@de ;
                  sh:maxCount  1 ;
                  sh:path         melod:hasCertainty ;
                  sh:class melod:Certainty
                ] ;
  sh:property   [ sh:description "e.g. 1 January 1800"@en,"z.B. 01. Januar 1800"@de ;
                  sh:name      "Description"@en,"Beschreibung"@de ;
                  sh:maxCount  1 ;
                  sh:path      schema:description
                ] ;
  sh:targetClass  melod:ExactDate .

  melod:TitlePage
  a               sh:NodeShape ;
  sh:property   [ sh:description "Type of the title page"@en,"Typ der Titelseite"@de ;
                  sh:name      "Type"@en,"Typ"@de ;
                  sh:minCount  0 ;
                  sh:maxCount  1 ;
                  sh:path      cidoc:P2_has_type
                ] ;
  sh:property   [ sh:name      "Transcription of the item's title page"@en,"Transkription der Titelseite des Items"@de ;
                  sh:description "Transcription"@en,"Transkription"@de ;
                  sh:minCount  1 ;
                  sh:maxCount  1 ;
                  dash:singleLine false ;
                  sh:path      melod:paragraph
                ] ;
  sh:targetClass  melod:TitlePage .

  melod:PhysDesc
  a               sh:NodeShape ;
  sh:property   [ sh:name      "Orientation"@en,"Ausrichtung"@de ;
                  sh:description "Page orientation, e.g. landscape or portrait"@en,"Seitenausrichtung, z.B. Hochformat oder Querformat"@de ;
                  sh:minCount  0 ;
                  sh:maxCount  1 ;
                  sh:in ( "landscape" "portrait" "oblong" "square" "other" ) ;
                  sh:group melod:Dimensions ;
                  sh:path      melod:hasOrientation
                ] ;
  sh:property   [ sh:name      "Extent"@en,"Umfang"@de ;
                  sh:minCount  0 ;
                  sh:maxCount  1 ;
                  sh:group melod:Dimensions ;
                  sh:path      melod:hasExtent ;
                  sh:node      melod:Extent
                ] ;
  sh:property   [ sh:name      "Dimension"@en,"Dimension"@de ;
                  sh:description "Height, width or depth of the source"@en,"Höhe, Breite oder Tiefe der Quelle"@de ;
                  sh:minCount  0 ;
                  sh:maxCount  3 ;
                  sh:group melod:Dimensions ;
                  sh:path      lrmoo:R70_has_dimension ;
                  sh:node melod:Dimension
                ] ;
  sh:property   [ sh:description "Physical medium of the item"@en,"Physikalisches Medium des Items"@de ;
                  sh:name "Physical medium"@en,"Physikalisches Medium"@de ;
                  sh:group melod:PaperPhysMedium ;
                  sh:minCount 0 ;
                  sh:or (
                    [ rdfs:label "Paper"@en,"Papier"@de ; sh:node melod:PaperDetail ]
                    [ rdfs:label "Other physical mediums"@en,"Andere physikalische Medien"@de ; sh:datatype xsd:string ; dash:singleLine false ]
                  ) ;
                  sh:path melod:hasPhysMedium
                ] ;
  sh:property   [ sh:description "Plate number of the item"@en,"Plattennummer des Items"@de ;
                  sh:name "Plate number"@en,"Plattennummer"@de ;
                  sh:group melod:WrittenContent ;
                  sh:minCount 0 ;
                  sh:maxCount 1 ;
                  sh:path melod:hasPlateNum
                ] ;
  sh:property   [ sh:description "Script description"@en,"Beschreibung des handschriftlichen Inhalts"@de ;
                  sh:name "Script description"@en,"Manuskript Beschreibung"@de ;
                  sh:group melod:WrittenContent ;
                  sh:minCount 0 ;
                  sh:maxCount 1 ;
                  sh:path melod:hasScriptDesc ;
                  dash:singleLine false
                ] ;
  sh:property   [ sh:description "Additions autograph"@en,"Autographische Ergänzungen"@de ;
                  sh:name "Additions autograph"@en,"Autographische Ergänzungen"@de ;
                  sh:group melod:WrittenContent ;
                  sh:minCount 0 ;
                  sh:maxCount 1 ;
                  sh:path melod:hasAddDescAutograph ;
                  dash:singleLine false
                ] ;
  sh:property   [ sh:description "Additions foreign"@en,"Fremde Ergänzungen"@de ;
                  sh:name "Additions foreign"@en,"Fremde Ergänzungen"@de ;
                  sh:group melod:WrittenContent ;
                  sh:minCount 0 ;
                  sh:maxCount 1 ;
                  dash:singleLine false ;
                  sh:path melod:hasAddDescForeign
                ] ;
  sh:property   [ sh:description "Foliation autograph"@en,"Autographische Foliierung"@de ;
                  sh:name "Foliation autograph"@en,"Autographische Foliierung"@de ;
                  sh:group melod:Foliation ;
                  sh:minCount 0 ;
                  sh:maxCount 1 ;
                  dash:singleLine false ;
                  sh:path melod:hasSupportDescAutograph
                ] ;
  sh:property   [ sh:description "Foliation foreign"@en,"Fremde Foliierung"@de ;
                  sh:name "Foliation foreign"@en,"Fremde Foliierung"@de ;
                  sh:group melod:Foliation ;
                  sh:minCount 0 ;
                  sh:maxCount 1 ;
                  dash:singleLine false ;
                  sh:path melod:hasSupportDescForeign
                ] ;
  sh:property   [ sh:description "Condition"@de,"Zustand"@en ;
                  sh:name "Condition"@de,"Zustand"@en ;
                  sh:group melod:Condition ;
                  sh:minCount 0 ;
                  sh:maxCount 1 ;
                  dash:singleLine false ;
                  sh:path melod:hasCondition
                ] ;
  sh:property   [ sh:description "Decoration description"@en, "Beschreibung der Verzierung"@de ;
                  sh:name "Decoration"@en,"Verzierung"@de ;
                  sh:group melod:Decoration ;
                  sh:minCount 0 ;
                  sh:maxCount 1 ;
                  sh:path melod:hasDecoDesc ;
                  dash:singleLine false
                ] ;
  sh:property   [ sh:description "Binding"@en,"Bindung"@de ;
                  sh:name "Binding"@en,"Bindung"@de ;
                  sh:group melod:Binding ;
                  sh:minCount 0 ;
                  sh:maxCount 1 ;
                  sh:path melod:hasBinding ;
                  sh:node melod:Binding
                ] ;
  sh:property   [ sh:description "Stamp"@en,"Stempel"@de ;
                  sh:name "Stamp"@en,"Stempel"@de ;
                  sh:group melod:Markings ;
                  sh:minCount 0 ;
                  sh:path melod:hasStamp
                ] ;
  sh:property   [ sh:name      "Inscription"@en,"Inschrift"@de ;
                  sh:group melod:Markings ;
                  sh:minCount  0 ;
                  sh:path      melod:hasInscription ;
                  sh:node melod:Inscription
                ] ;
  sh:property   [ sh:name      "Watermark"@en,"Wasserzeichen"@de ;
                  sh:group melod:Markings ;
                  sh:minCount  0 ;
                  sh:path      melod:hasWatermark ;
                  sh:node melod:Watermark
                ] ;
  sh:targetClass  melod:PhysicalDescription .

melod:PaperDetail
  a               sh:NodeShape ;
  rdfs:label      "Paper"@en,"Papier"@de ;
  sh:property   [ sh:name      "Name"@en,"Name"@de ;
                  sh:description "Name or short label for this paper type"@en,"Name oder Kurzlabel für diesen Papiertyp"@de ;
                  sh:minCount  0 ;
                  sh:maxCount  1 ;
                  sh:group melod:PaperIdentification ;
                  sh:path      rdfs:label
                ] ;
  sh:property   [ sh:name      "Page range"@en,"Seitenbereich"@de ;
                  sh:description "Page range of the given paper type"@en,"Seitenbereich des vorhandenen Papiertyps"@de ;
                  sh:maxCount  1 ;
                  sh:group melod:PaperIdentification ;
                  sh:path      schema:pagination
                ] ;
  sh:property   [ sh:name      "Extent"@en,"Umfang"@de ;
                  sh:description "Number of pages or folios of this paper type"@en,"Anzahl der Seiten oder Folios dieses Papiertyps"@de ;
                  sh:minCount  0 ;
                  sh:maxCount  1 ;
                  sh:group melod:PaperDimensions ;
                  sh:path      melod:hasExtent ;
                  sh:node      melod:Extent
                ] ;
  sh:property   [ sh:name      "Format"@en,"Format"@de ;
                  sh:description "Height or width of the format"@en,"Höhe oder Breite des Formats"@de ;
                  sh:minCount  0 ;
                  sh:maxCount  2 ;
                  sh:group melod:PaperDimensions ;
                  sh:path      melod:hasFormat ;
                  sh:node melod:Format
                ] ;
  sh:property   [ sh:name      "Rastral mirror"@en,"Rastralspiegel"@de ;
                  sh:description "Height or width of the rastral mirror"@en,"Höhe oder Breite des Rastralspiegels"@de ;
                  sh:minCount  0 ;
                  sh:maxCount  1 ;
                  sh:group melod:PaperDimensions ;
                  sh:path      melod:hasRastral ;
                  sh:node melod:Rastral
                ] ;
  sh:property   [ sh:description "Paper quality"@en,"Papierqualität"@de ;
                  sh:name "Paper quality"@en,"Papierqualität"@de ;
                  sh:minCount 0 ;
                  sh:maxCount 1 ;
                  sh:group melod:PaperQuality ;
                  dash:singleLine false ;
                  sh:path melod:hasPaperQuality
                ] ;
  sh:property   [ sh:description "Condition of the paper"@en,"Zustand des Papiers"@de ;
                  sh:name "Condition"@en,"Zustand"@de ;
                  sh:minCount 0 ;
                  sh:maxCount 1 ;
                  sh:group melod:PaperQuality ;
                  dash:singleLine false ;
                  sh:path melod:hasCondition
                ] ;
  sh:targetClass  melod:PaperDetail .

melod:Extent
  a               sh:NodeShape ;
  owl:imports     terms:melod-terms.ttl ;
  sh:property   [ sh:description "Number of pages or folios"@en,"Anzahl der Seiten oder Folios"@de ;
                  sh:name      "Value"@en,"Wert"@de ;
                  sh:minCount  1 ;
                  sh:maxCount  1 ;
                  sh:path      cidoc:P90_has_value
                ] ;
  sh:property   [ sh:name      "Unit"@en,"Einheit"@de ;
                  sh:minCount  0 ;
                  sh:maxCount  1 ;
                  sh:class cidoc:E58_Measurement_Unit ;
                  sh:path      cidoc:P91_has_unit
                ] ;
  sh:targetClass  melod:Extent .

melod:Watermark
  a               sh:NodeShape ;
  sh:property   [ sh:description "Type of the watermark"@en,"Typ des Wasserzeichens"@de ;
                  sh:name      "Type"@en,"Typ"@de ;
                  sh:minCount  0 ;
                  sh:maxCount  1 ;
                  sh:path      cidoc:P2_has_type
                ] ;
  sh:property   [ sh:description "Link to an external web resource"@en,"Link zu einer externen Webressource"@de ;
                  sh:name      "Link"@en,"Link"@de ;
                  sh:minCount  0 ;
                  sh:nodeKind sh:IRI ;
                  sh:pattern "^http(s)?://.+?/..+?" ;
                  sh:path      owl:sameAs
                ] ;
  sh:property   [ sh:name      "Heraldry"@en,"Heraldik"@de ;
                  sh:description "Heraldric Compononent (motives)"@en,"Heraldische Komponente (Motive)"@de ;
                  sh:minCount  0 ;
                  sh:maxCount  1 ;
                  sh:path      melod:hasHeraldry
                ] ;
  sh:property   [ sh:name      "Content"@en,"Inhalt"@de ;
                  sh:description "Content (not heraldic)"@en,"Inhalt (nicht heraldisch)"@de ;
                  sh:minCount  0 ;
                  sh:maxCount  1 ;
                  dash:singleLine false ;
                  sh:path      melod:hasContent
                ] ;
  sh:property   [ sh:name      "Paper position"@en,"Papierposition"@de ;
                  sh:description "Position of the watermark on the paper (e.g. left part of the paper)"@en,"Position des Wasserzeichens auf dem Papier (z.B. linker Teil des Papiers)"@de ;
                  sh:minCount  0 ;
                  sh:maxCount  1 ;
                  sh:path      melod:paperPosition
                ] ;
  sh:property   [ sh:name      "Dimension"@en,"Dimension"@de ;
                  sh:description "Height and width of the watermark"@en,"Höhe und Breite des Wasserzeichens"@de ;
                  sh:minCount  0 ;
                  sh:maxCount  2 ;
                  sh:path      lrmoo:R70_has_dimension ;
                  sh:node melod:Format
                ] ;
  sh:property   [ sh:description "Date of the creation of the watermark"@en,"Entstehungsdatum des Wasserzeichens"@de ;
                  sh:name "Creation date"@en,"Entstehungsdatum"@de ;
                  sh:minCount 0 ;
                  sh:maxCount 1 ;
                  sh:path schema:dateCreated ;
                  sh:or (
                    [ sh:node melod:ExactDate ; rdfs:label "Single date" ]
                    [ sh:node melod:Date ; rdfs:label "Date span" ]
                  )
                ] ;
  sh:property   [ sh:description "Choose the creation place..."@en,"Wähle den Entstehungsort..."@de ;
                  sh:name "Creation place"@en,"Entstehungsort"@de ;
                  sh:minCount 0 ;
                  sh:maxCount 1 ;
                  sh:group melod:Creation ;
                  sh:path schema:locationCreated ;
                  #sh:defaultValue "https://mei-metadata.org/places/" ;
                  #sh:pattern      "^https://mei-metadata.org/places/\\d{8}" ;
                  sh:class melod:PlaceEntity ;
                ] ;
  sh:property   [ sh:description  "Choose paper maker (person)..."@en,"Wähle Papierhersteller (Person)"@de ;
                  sh:name         "Paper maker"@en,"Papierhersteller"@de ;
                  sh:maxCount  1 ;
                  sh:path      melod:hasPaperMaker ;
                  sh:class melod:PersonEntity ;
                ] ;
  sh:property   [ sh:description  "Insert link or name of the paper mill"@en,"Füge den Link oder Namen der Papiermühle ein"@de ;
                  sh:name         "Paper mill"@en,"Papiermühle"@de ;
                  sh:maxCount  1 ;
                  sh:path      melod:hasPaperMill ;
                  sh:nodeKind sh:IRI ;
                  sh:pattern "^http(s)?://.+?/..+?" ;
                ] ;
  sh:property   [ sh:description  "Insert link or name of the twin mark"@en, "Füge den Link oder Namen eines Zwillingswasserzeichen ein"@de ;
                  sh:name         "Twin mark"@en,"Zwillingswasserzeichen"@de ;
                  sh:maxCount  1 ;
                  sh:path      melod:hasTwinMark ;
                  sh:nodeKind sh:IRI ;
                  sh:pattern "^http(s)?://.+?/..+?" ;
                ] ;
  sh:targetClass  melod:Watermark .

melod:Inscription
  a               sh:NodeShape ;
  sh:property   [ sh:description  "Choose person..."@en,"Wähle Person..." ;
                  sh:name         "Person"@en,"Person"@de ;
                  sh:path      melod:hasAgent ;
                  sh:class melod:PersonEntity ;
                ] ;
  sh:property   [ sh:description "Description of the inscription"@en, "Beschreibung der Inschrift"@de ;
                  sh:name      "Description"@en, "Beschreibung"@de ;
                  dash:singleLine false ;
                  sh:path      schema:description
                ] ;
  sh:targetClass  melod:Inscription .

melod:Annotation
  a               sh:NodeShape ;

  sh:property   [ sh:description "e.g. Comments, Edits, Notes"@en, "z.B. Kommentare, Bearbeitungen, Notizen"@de ;
                  sh:name      "Label"@en,"Bezeichnung"@de ;
                  sh:minCount  0 ;
                  sh:maxCount  1 ;
                  sh:path      rdfs:label
                ] ;
  sh:property   [ sh:description      "Paragraph"@en, "Text"@de ;
                  sh:name      "Paragraph"@en, "Text"@de ;
                  sh:minCount  1 ;
                  sh:datatype  rdf:HTML ;
                  dash:singleLine false ;
                  sh:path      melod:paragraph
                ] ;
  sh:targetClass  melod:Annotation .

melod:Link
  a               sh:NodeShape ;

  sh:property   [ sh:description "e.g. digitised content" ;
                  sh:name      "Label" ;
                  sh:minCount  0 ;
                  sh:maxCount  1 ;
                  sh:path      rdfs:label
                ] ;
  sh:property   [ sh:description "URL" ;
                  sh:name      "URL" ;
                  sh:minCount  1 ;
                  sh:nodeKind  sh:IRI ;
                  sh:path      melod:hasURL
                ] ;
  sh:targetClass  melod:Link .

melod:Binding
  a               sh:NodeShape ;
  sh:property   [ sh:name      "Description"@en,"Beschreibung"@de ;
                  sh:maxCount  1 ;
                  dash:singleLine false ;
                  sh:path      schema:description
                ] ;
  sh:property   [ sh:name      "Dimension"@en,"Dimension"@de ;
                  sh:description "Height and width of the binding"@en,"Höhe und Breite der Bindung"@de ;
                  sh:minCount  0 ;
                  sh:maxCount  2 ;
                  sh:path      lrmoo:R70_has_dimension ;
                  sh:node melod:Format
                ] ;
  sh:property   [ sh:description "Condition of the binding"@en,"Zustand der Bindung"@de ;
                  sh:name "Condition"@en,"Zustand"@de ;
                  sh:minCount 0 ;
                  sh:maxCount 1 ;
                  dash:singleLine false ;
                  sh:path melod:hasCondition
                ] ;
  sh:property   [ sh:description "Decoration description of the binding"@en,"Beschreibung der Bindungsverzierung"@de ;
                  sh:name "Binding decoration"@en,"Bindungsverzierung"@de ;
                  sh:minCount 0 ;
                  sh:maxCount 1 ;
                  dash:singleLine false ;
                  sh:path melod:hasDecoDesc
                ] ;
  sh:targetClass  melod:Binding .

  melod:Dimension
  a               sh:NodeShape ;
  owl:imports     terms:melod-terms.ttl ;
  sh:property   [ sh:description "Type (height, width or depth)"@en,"Typ (Höhe, Breite, Tiefe)"@de ;
                  sh:name      "Type"@en,"Typ"@de ;
                  sh:minCount  1 ;
                  sh:maxCount  1 ;
                  sh:in ( "height" "width" "depth" ) ;
                  sh:path      cidoc:P2_has_type
                ] ;
  sh:property   [ sh:description      "Value"@en,"Wert"@de ;
                  sh:name      "Value"@en,"Wert"@de ;
                  sh:minCount  0 ;
                  sh:maxCount  1 ;
                  sh:path      cidoc:P90_has_value
                ] ;
  sh:property   [ sh:description      "Unit of the value"@en,"Einheit des Wertes"@de ;
                  sh:name      "Unit"@en,"Einheit"@de ;
                  sh:minCount  0 ;
                  sh:maxCount  1 ;
                  sh:class cidoc:E58_Measurement_Unit ;
                  sh:path      cidoc:P91_has_unit
                ] ;
  sh:targetClass  cidoc:E54_Dimension .

  melod:Format
  a               sh:NodeShape ;
  owl:imports     terms:melod-terms.ttl ;
  sh:property   [ sh:description "Type (height or width)"@en,"Typ (Höhe oder Breite)"@de ;
                  sh:name      "Type"@en,"Typ"@de ;
                  sh:minCount  1 ;
                  sh:maxCount  1 ;
                  sh:in ( "height" "width" ) ;
                  sh:path      cidoc:P2_has_type
                ] ;
  sh:property   [ sh:description      "Value"@en,"Wert"@de ;
                  sh:name      "Value"@en,"Wert"@de ;
                  sh:minCount  0 ;
                  sh:maxCount  1 ;
                  sh:path      cidoc:P90_has_value
                ] ;
  sh:property   [ sh:description      "Unit of the value"@en,"Einheit des Wertes"@de ;
                  sh:name      "Unit"@en,"Einheit"@de ;
                  sh:minCount  0 ;
                  sh:maxCount  1 ;
                  sh:class cidoc:E58_Measurement_Unit ;
                  sh:path      cidoc:P91_has_unit
                ] ;
  sh:targetClass  melod:Format .

  melod:Rastral
  a               sh:NodeShape ;
  sh:property   [ sh:name      "Dimension"@en,"Dimension"@de ;
                  sh:description "Height and width of the rastral"@en,"Höhe und Breite des Rastrals"@de ;
                  sh:minCount  0 ;
                  sh:maxCount  2 ;
                  sh:path      lrmoo:R70_has_dimension ;
                  sh:node melod:Format
                ] ;
  sh:targetClass  melod:Rastral .

  melod:Hand
  a               sh:NodeShape ;
  rdfs:label      "Hand"@en,"Hand"@de ;
  owl:imports     terms:melod-terms.ttl ;
  sh:property   [ sh:maxCount  1 ;
                  sh:description "Choose person..."@de,"Wähle Person..."@de ;
                  sh:name "Name"@en,"Name"@de ;
                  sh:path      melod:hasAgent ;
                  #sh:defaultValue "https://mei-metadata.org/persons/" ;
                  #sh:pattern      "^https://mei-metadata.org/persons/\\d{8}" ;
                  sh:class melod:PersonEntity ;
                ] ;
  sh:property   [ sh:description  "Type of the hand"@en,"Typ der Schreiberhand"@de ;
                  sh:name         "Type"@en,"Typ"@de ;
                  sh:maxCount  1 ;
                  sh:path         melod:hasHandType ;
                  sh:class melod:HandType
                ] ;
  sh:property   [ sh:description  "Medium of the hand"@en,"Medium der Schreiberhand"@de ;
                  sh:name         "Medium"@en,"Medium"@de ;
                  sh:maxCount  1 ;
                  sh:path         melod:hasMedium ;
                  sh:class melod:Medium
                ] ;
  sh:property   [ sh:description "Description"@en,"Beschreibung"@de ;
                  sh:name         "Description"@en,"Beschreibung"@de ;
                  sh:maxCount  1 ;
                  dash:singleLine false ;
                  sh:path         schema:description
                ] ;              
  sh:targetClass  melod:Hand .

melod:Relation
  a               sh:PropertyGroup ;
  sh:order        6 ;
  rdfs:label      "Relations"@en, "Beziehungen"@de .

  melod:General
  a               sh:PropertyGroup ;
  sh:order        1 ;
  rdfs:label      "General Information"@en, "Allgemeine Informationen"@de .

  melod:Keywords
  a               sh:PropertyGroup ;
  sh:order        2 ;
  rdfs:label      "Classification and Keywords"@en, "Klassifikation und Schlagwörter"@de .

  melod:Location
  a               sh:PropertyGroup ;
  sh:order        3 ;
  rdfs:label      "Location"@en,"Fundort"@de .

  melod:Provenance
  a               sh:PropertyGroup ;
  sh:order        4 ;
  rdfs:label      "Provenance"@en,"Provenienz"@de .

  melod:PhysicalDescription
  a               sh:PropertyGroup ;
  sh:order        5 ;
  rdfs:label      "Physical Properties"@en,"Physische Eigenschaften"@de .

  # PhysDesc sub-groups (used within melod:PhysDesc NodeShape)
  melod:Dimensions
  a               sh:PropertyGroup ;
  sh:order        10 ;
  rdfs:label      "Dimensions and Extent"@en,"Dimensionen und Umfang"@de .

  melod:PaperPhysMedium
  a               sh:PropertyGroup ;
  sh:order        20 ;
  rdfs:label      "Physical Medium"@en,"Physisches Medium"@de .

  melod:WrittenContent
  a               sh:PropertyGroup ;
  sh:order        30 ;
  rdfs:label      "Written Content"@en,"Schriftlicher Inhalt"@de .

  melod:Foliation
  a               sh:PropertyGroup ;
  sh:order        40 ;
  rdfs:label      "Foliation"@en,"Foliierung"@de .

  melod:Markings
  a               sh:PropertyGroup ;
  sh:order        80 ;
  rdfs:label      "Markings"@en,"Markierungen" .

  melod:Condition
  a               sh:PropertyGroup ;
  sh:order        50 ;
  rdfs:label      "Condition"@en,"Zustand"@de .

  melod:Decoration
  a               sh:PropertyGroup ;
  sh:order        60 ;
  rdfs:label      "Decoration"@en,"Verzierung"@de .

  melod:Binding
  a               sh:PropertyGroup ;
  sh:order        70 ;
  rdfs:label      "Binding"@en,"Bindung"@de .

  # PaperDetail sub-groups
  melod:PaperIdentification
  a               sh:PropertyGroup ;
  sh:order        10 ;
  rdfs:label      "Identification"@en,"Identifizierung"@de .

  melod:PaperDimensions
  a               sh:PropertyGroup ;
  sh:order        20 ;
  rdfs:label      "Dimensions"@en,"Dimensionen"@de .

  melod:PaperQuality
  a               sh:PropertyGroup ;
  sh:order        30 ;
  rdfs:label      "Quality and Condition"@en,"Qualität und Zustand"@de .

  melod:Event
  a sh:NodeShape, rdfs:Class ;
  owl:imports     terms:melod-terms.ttl ;
  sh:property   [ sh:description "Name of the Event"@en, "Name des Ereignisses"@de ;
                  sh:name "Name"@en, "Name"@de ;
                  sh:minCount 1 ;
                  sh:maxCount 1;
                  sh:path rdfs:label
                ] ;
  sh:property   [ sh:description "Choose place..."@en, "Wähle den Ort..."@de ;
                  sh:name "Place"@en, "Ort"@de ;
                  sh:maxCount 1;
                  sh:class melod:PlaceEntity ;
                  #sh:defaultValue "https://mei-metadata.org/places/" ;
                  #sh:pattern      "^https://mei-metadata.org/places/\\d{8}" ;
                  sh:path schema:location
                ] ;
  sh:property   [ sh:description "Date of the event"@en, "Datum des Ereignisses"@de ;
                  sh:name "Date"@en, "Datum"@de ;
                  sh:minCount 0 ;
                  sh:maxCount 1 ;
                  sh:path melod:hasEventDate ;
                  sh:or (
                    [ sh:node melod:ExactDate ; rdfs:label "Single date" ]
                    [ sh:node melod:Date ; rdfs:label "Date span" ]
                  )
                ] ;
  sh:property   [ sh:description "Contributor of the event"@en, "Mitwirkende des Ereignisses"@de ;
                  sh:name "Person or Institution"@en, "Person oder Institution"@de ;
                  sh:minCount 0 ;
                  sh:group melod:Contributors ;
                  sh:node melod:Contribution ;
                  sh:path melod:hasContribution
                ] ;
  sh:property   [ sh:description "Description, annotations or further information"@en, "Beschreibung, Anmerkungen oder weitere Informationen"@de ;
                  sh:name "Description"@en, "Beschreibung"@de ;
                  dash:singleLine false ;
                  sh:maxCount 1 ;
                  sh:path schema:description
                ] ;
  sh:targetClass melod:Event .

  melod:Contribution
  a               sh:NodeShape ;
  rdfs:label      "Contributors" ;
  owl:imports     terms:melod-terms.ttl ;
  sh:property   [ sh:description  "Choose Person or Institution..."@en, "Wähle Person oder Institution..."@de ;
                  sh:name         "Person/Institution"@en, "Person/Institution"@de ;
                  sh:maxCount  1 ;
                  sh:minCount  1 ;
                  sh:path      melod:hasAgent ;
                  sh:nodeKind sh:IRI ;
                  sh:or (
                    [ sh:class melod:PersonEntity ; rdfs:label "Person"@en, "Person"@de ]
                    [ sh:class melod:InstitutionEntity; rdfs:label "Institution"@en, "Institution"@de ]
                  )
                ] ;
  sh:property   [ sh:description  "Role of the contribution"@en, "Rolle des Beitrags"@de ;
                  sh:name         "Role"@en, "Rolle"@de ;
                  sh:maxCount  1 ;
                  sh:path         melod:hasRole ;
                  sh:class melod:Role
                ] ;
  sh:property   [ sh:description  "Certainty of the contribution"@en, "Sicherheit des Beitrags"@de ;
                  sh:name         "Certainty"@en, "Sicherheit"@de ;
                  sh:maxCount  1 ;
                  sh:path         melod:hasCertainty ;
                  sh:class melod:Certainty
                ] ;
  sh:targetClass  melod:Contribution .


  melod:Identifier
  a               sh:NodeShape ;
  sh:property   [ sh:description "Name of a list, catalogue or other numbering system in which the item is identified (e.g. 'Opus', 'CNW', 'BWV', 'Neue Mozart-Ausgabe' etc.)."@en, "Name einer Liste, eines Katalogs oder eines anderen Nummerierungssystems, in dem das Item identifiziert wird (z.B. 'Opus', 'CNW', 'BWV', 'Neue Mozart-Ausgabe' etc.)."@de ;
                  sh:name      "List name"@en, "Listenname"@de ;
                  sh:minCount  1 ;
                  sh:maxCount  1 ;
                  sh:path      rdfs:label
                ] ;
  sh:property   [ sh:description "The items' number or signature in the list identifying it."@en, "Die Nummer oder Signatur des Items in der Liste, in der sie identifiziert wird."@de ;
                  sh:name      "Number"@en, "Nummer"@de ;
                  sh:minCount  1 ;
                  sh:maxCount  1 ;
                  sh:datatype  xsd:string ;
                  sh:path      owl:hasValue
                ] ;
  sh:targetClass melod:Identifier .