prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
prefix melod: <https://lod.academy/melod/vocab/ontology#>
prefix skos: <http://www.w3.org/2004/02/skos/core#>
prefix schema: <https://schema.org/>
prefix cs: <https://lod.academy/correspsearch/vocab/terms#>

construct {
  ?letter_iri a melod:Letter ;
  	skos:prefLabel ?label ;
    skos:related ?person_iri ;
    skos:related ?place_iri .
} where {
  select ?letter_iri ?label ?person_iri ?place_iri where {
    ?letter_iri a melod:Letter .
    ?letter_iri rdfs:label ?letter_title .
    OPTIONAL {
      ?letter_iri cs:hasCorrespAction ?corresp_node .
      ?corresp_node cs:hasParticipant ?person_iri .
    }
    OPTIONAL {
      ?letter_iri cs:hasCorrespAction ?corresp_node .
      ?corresp_node cs:tookPlaceAt ?place_iri .
    }
    bind(?letter_title AS ?label)
  }
  order by ?label
}