prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
prefix melod: <https://lod.academy/melod/vocab/ontology#>
prefix skos: <http://www.w3.org/2004/02/skos/core#>
prefix schema: <https://schema.org/>
prefix terms: <https://lod.academy/melod/vocab/terms#>

construct {
  ?expression_iri a melod:ExpressionEntity ;
  	skos:prefLabel ?label ;
    skos:related ?performance_iri ;
    skos:related ?first_performance_iri ;
    skos:related ?place_iri ;
    skos:related ?contributor_iri ;
    skos:related ?expression_part_iri ;
    skos:related ?expression_part_of_iri ;
    skos:related ?expression_component_iri ;
    skos:related ?event_iri ;
    skos:related ?instrumentation_iri ;
    skos:related ?bibliography_iri ;
    skos:related ?incipit_mei ;
    skos:broader ?classification .
} where {
  select ?expression_iri ?label ?performance_iri ?first_performance_iri ?event_iri ?place_iri ?contributor_iri ?expression_part_iri ?expression_part_of_iri ?expression_component_iri ?instrumentation_iri ?bibliography_iri ?classification ?incipit_mei where {
    ?expression_iri a melod:Expression .
    OPTIONAL { 
      ?expression_iri rdfs:label ?existing_label . 
    }
    OPTIONAL { 
      ?expression_iri schema:position ?position .
    }
    bind(coalesce(?existing_label, STR(?expression_iri)) AS ?expression_label)
    OPTIONAL {
      ?expression_iri melod:hasIncipit ?incipit_iri .
      ?incipit_iri melod:hasIncipitText ?incipit_text .
    }
    OPTIONAL {
      ?expression_iri melod:hasPerformance ?performance_iri .
      FILTER(isIRI(?performance_iri)) .
    }
    OPTIONAL {
      ?expression_iri schema:firstPerformance ?first_performance_iri .
      FILTER(isIRI(?first_performance_iri)) .
    }
    OPTIONAL {
      ?expression_iri schema:locationCreated ?place_iri .
    }
    OPTIONAL {
      ?expression_iri melod:hasContribution ?contributor_node .
      ?contributor_node melod:hasAgent ?contributor_iri .
    }
    OPTIONAL {
      ?expression_iri melod:hasExpressionPart ?expression_part_iri .
    }
    OPTIONAL {
      ?expression_iri melod:isExpressionPartOf ?expression_part_of_iri .
    }
    OPTIONAL {
      ?expression_iri schema:includedComposition ?expression_component_iri .
    }
    OPTIONAL {
      ?expression_iri melod:hasHistoricEvent ?event_iri .
      FILTER(isIRI(?event_iri)) .
    }
    OPTIONAL {
      ?expression_iri melod:hasInstrumentation ?instrumentation_iri .
    }
    OPTIONAL {
      ?expression_iri schema:citation ?bibliography_iri .
    }
    OPTIONAL {
      ?expression_iri melod:hasClassification ?classification .
    }
    OPTIONAL {
      ?expression_iri melod:hasIncipit ?incipit_node .
      ?incipit_node melod:hasMEIScore ?incipit_mei .
    }
    bind(coalesce(concat(?expression_label, " ('", ?incipit_text, "')"), ?expression_label) AS ?label_incipit)
    bind(coalesce(concat(?position, ". '", ?label_incipit), ?label_incipit) AS ?label)
  }
  order by ?label
}
